@article{Placais2020,
  title = {A Three-Dimensional {{Dionne}} Model for Multipactor Simulations},
  author = {Pla{\c c}ais, Adrien and Belhaj, Mohamed and Hillairet, Julien and Puech, J{\'e}r{\^o}me},
